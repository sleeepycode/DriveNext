<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:focusableInTouchMode="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="#F5F0FB">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><androidx.appcompat.widget.AppCompatImageButton android:id="@+id/searchBack" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_lab2_back" android:contentDescription="Назад" android:background="?attr/selectableItemBackgroundBorderless"/><TextView android:id="@+id/searchTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Результаты поиска" android:textSize="18sp" android:textColor="@color/text_primary" android:fontFamily="@font/montserrat_semibold" android:layout_weight="1" android:gravity="center" android:visibility="gone"/><Space android:layout_width="8dp" android:layout_height="1dp"/></LinearLayout>
<androidx.appcompat.widget.SearchView android:id="@+id/carSearch" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_lab3_search" app:iconifiedByDefault="false" app:queryHint="Введите марку автомобиля" android:inputType="text" android:maxWidth="1200dp"/>
<TextView android:id="@+id/homeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Давайте найдём автомобиль" android:textSize="16sp" android:textColor="@color/text_primary" android:fontFamily="@font/montserrat_semibold" android:layout_marginTop="16dp" android:layout_marginBottom="6dp"/>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<androidx.recyclerview.widget.RecyclerView android:id="@+id/carList" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="8dp"/>
<TextView android:id="@+id/emptyCars" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="@color/text_primary" android:fontFamily="@font/montserrat_regular" android:layout_gravity="center" android:gravity="center" android:padding="16dp" android:visibility="gone"/>
</FrameLayout></LinearLayout>
