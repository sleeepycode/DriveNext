<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <TextView
        android:id="@+id/authTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="64dp"
        android:fontFamily="@font/montserrat_semibold"
        android:text="@string/splash_title"
        android:textColor="@color/primary"
        android:textSize="@dimen/text_title"
        android:includeFontPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/authSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="@dimen/spacing_small"
        android:fontFamily="@font/montserrat_regular"
        android:text="@string/splash_subtitle"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_body"
        android:includeFontPadding="false"
        app:layout_constraintTop_toBottomOf="@id/authTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/authImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="24dp"
        android:src="@drawable/main"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        app:layout_constraintWidth_percent="0.82"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/authSubtitle"
        app:layout_constraintBottom_toTopOf="@id/authButtons" />

    <LinearLayout
        android:id="@+id/authButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginBottom="80dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/auth_login"
            android:textColor="@color/button_text"
            android:textSize="@dimen/text_button"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:enabled="true" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/registerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_secondary_button"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/auth_register"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_button"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:enabled="true" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>